rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function userPath(uid){return /databases/$(database)/documents/users/$(uid);}
    function enrolled(){return signedIn() && exists(userPath(request.auth.uid));}
    function profileEnabled(data){
      return (!('active' in data) || data.active == true)
        && (!('status' in data) || data.status == "active")
        && (!('expiresAt' in data) || data.expiresAt == null || request.time < data.expiresAt);
    }
    function registered(){return enrolled() && profileEnabled(get(userPath(request.auth.uid)).data);}
    function myUser(){return get(userPath(request.auth.uid));}
    function isSystemAdmin(){return registered() && myUser().data.systemRole in ["owner", "admin"];}
    function isSystemOwner(){return registered() && myUser().data.systemRole == "owner";}
    function isConversationMember(conversationId){return registered() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;}

    function groupDoc(groupId){return get(/databases/$(database)/documents/groups/$(groupId));}
    function groupDocAfter(groupId){return getAfter(/databases/$(database)/documents/groups/$(groupId));}
    function isGroupMember(groupId){return registered() && exists(/databases/$(database)/documents/groups/$(groupId)) && request.auth.uid in groupDoc(groupId).data.memberUids;}
    function isGroupAdmin(groupId){return isGroupMember(groupId) && request.auth.uid in groupDoc(groupId).data.adminUids;}
    function isGroupAdminAfter(groupId){return registered() && request.auth.uid in groupDocAfter(groupId).data.adminUids;}
    function validGroupLists(data){
      return data.memberUids is list
        && data.adminUids is list
        && data.memberUids.size() > 0
        && data.memberUids.size() <= 64
        && data.adminUids.size() > 0
        && data.adminUids.size() <= 64
        && data.ownerUid in data.memberUids
        && data.ownerUid in data.adminUids
        && data.adminUids.hasOnly(data.memberUids);
    }
    function validGroupShape(data){
      return data.type == "group"
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.ownerUid is string
        && data.createdByUid is string
        && data.ownerUid == data.createdByUid
        && data.historyPolicy == "fromJoin"
        && data.groupVersion == 1
        && data.keyEpoch == 0
        && validGroupLists(data);
    }
    function validInviteRole(role){return role in ["user", "admin"];}
    function inviteAfter(inviteId){return getAfter(/databases/$(database)/documents/invitations/$(inviteId));}
    function validInvitedProfile(uid,data){
      return data.joinedByInviteId is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.email is string
        && data.systemRole in ["user", "admin"]
        && data.active == true
        && inviteAfter(data.joinedByInviteId).data.status == "accepted"
        && inviteAfter(data.joinedByInviteId).data.acceptedUid == uid
        && inviteAfter(data.joinedByInviteId).data.role == data.systemRole;
    }
    function validLifecycle(data){
      return data.status in ["active","suspended","deactivated"]
        && ((data.status == "active" && data.active == true) || (data.status in ["suspended","deactivated"] && data.active == false))
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    match /system/access {
      allow read: if enrolled();
      allow create: if signedIn()
        && exists(userPath(request.auth.uid))
        && !exists(/databases/$(database)/documents/system/access)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /invitations/{inviteId} {
      allow get: if true;
      allow list: if isSystemAdmin();
      allow create: if isSystemAdmin()
        && request.resource.data.status == "pending"
        && validInviteRole(request.resource.data.role)
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp;
      allow update: if (
          signedIn()
          && resource.data.status == "pending"
          && request.time < resource.data.expiresAt
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","acceptedUid","acceptedEmail","acceptedAt"])
        ) || (
          isSystemAdmin()
          && resource.data.status == "pending"
          && request.resource.data.status == "revoked"
          && request.resource.data.role == resource.data.role
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","revokedAt"])
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && validInvitedProfile(uid,request.resource.data);
      allow update: if (
          registered() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName","email","telephone","photoURL","profileUpdatedAt","e2eePublicJwk","e2eeVersion","e2eeUpdatedAt"])
        ) || (
          registered() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/system/access)
          && getAfter(/databases/$(database)/documents/system/access).data.ownerUid == uid
          && request.resource.data.systemRole == "owner"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["systemRole"])
        ) || (
          isSystemAdmin()
          && request.auth.uid != uid
          && resource.data.systemRole != "owner"
          && (resource.data.systemRole != "admin" || isSystemOwner())
          && request.resource.data.systemRole == resource.data.systemRole
          && request.resource.data.adminUpdatedByUid == request.auth.uid
          && validLifecycle(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","active","expiresAt","suspendedAt","suspendedByUid","restoredAt","restoredByUid","deactivatedAt","deactivatedByUid","adminUpdatedAt","adminUpdatedByUid"])
        );
      allow read: if (signedIn() && request.auth.uid == uid) || registered();
      allow delete: if false;
      match /devices/{deviceId} {
        allow read: if registered();
        allow create, update: if registered() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.deviceId == deviceId && request.resource.data.e2eeVersion == 1 && request.resource.data.publicJwk is map && request.resource.data.fingerprint is string && request.resource.data.fingerprint.size() <= 128;
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if registered() && request.auth.uid in resource.data.members;
      allow create: if registered() && request.resource.data.type == "direct" && request.resource.data.members is list && request.resource.data.members.size() == 2 && request.auth.uid in request.resource.data.members;
      allow update: if registered() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members && request.resource.data.type == resource.data.type;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.state == "sent"
          && (
            (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 10000)
            ||
            (request.resource.data.e2ee == 1 && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() > 0 && request.resource.data.ciphertext.size() <= 20000 && request.resource.data.iv is string && request.resource.data.iv.size() > 0 && request.resource.data.iv.size() <= 128 && request.resource.data.text == "")
            ||
            (request.resource.data.e2ee == 2 && request.resource.data.ciphertext == "" && request.resource.data.iv == "" && request.resource.data.text == "" && request.resource.data.envelopes is map && request.resource.data.envelopes.size() > 0 && request.resource.data.envelopes.size() <= 32 && request.resource.data.recipientDeviceIds is list && request.resource.data.recipientDeviceIds.size() > 0 && request.resource.data.recipientDeviceIds.size() <= 32)
          );
        allow update: if isConversationMember(conversationId) && request.resource.data.senderUid == resource.data.senderUid && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state"]) && request.resource.data.state in ["delivered","read"];
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if registered() && request.auth.uid in resource.data.memberUids;
      allow create: if registered() && request.resource.data.ownerUid == request.auth.uid && validGroupShape(request.resource.data);
      allow update: if isGroupAdmin(groupId)
        && request.resource.data.type == resource.data.type
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.historyPolicy == resource.data.historyPolicy
        && request.resource.data.groupVersion == resource.data.groupVersion
        && request.resource.data.keyEpoch == resource.data.keyEpoch
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && validGroupLists(request.resource.data);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isGroupMember(groupId) || isGroupAdminAfter(groupId);
        allow create: if isGroupAdminAfter(groupId)
          && request.resource.data.uid == uid
          && uid in groupDocAfter(groupId).data.memberUids
          && request.resource.data.role in ["owner", "admin", "member"]
          && request.resource.data.active == true;
        allow update: if isGroupAdmin(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.addedByUid == resource.data.addedByUid
          && uid in groupDocAfter(groupId).data.memberUids
          && request.resource.data.role in ["owner", "admin", "member"]
          && request.resource.data.active == true;
        allow delete: if isGroupAdmin(groupId)
          && uid != groupDoc(groupId).data.ownerUid
          && !(uid in groupDocAfter(groupId).data.memberUids);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if false;
      }
    }
  }
}