rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    match /users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      // Authenticated profile reads remain required by the current direct
      // E2EE compatibility-key lookup. Narrow this when contact/invite
      // authorization is introduced.
      allow read: if signedIn();
      allow delete: if false;

      // 0.8.0 multi-device identity foundation.
      // Public device keys are readable by authenticated FIDUNIO users so a
      // future per-device envelope layer can encrypt separately to each
      // recipient installation. Only the account owner can create/update
      // their own device records.
      match /devices/{deviceId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.deviceId == deviceId
          && request.resource.data.e2eeVersion == 1
          && request.resource.data.publicJwk is map
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.size() <= 128;
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.type == "direct"
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;

      // For 0.6 direct conversations, membership/type cannot be changed after creation.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.type == resource.data.type;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.state in ["sent"]
          && (
            (request.resource.data.text is string
             && request.resource.data.text.size() > 0
             && request.resource.data.text.size() <= 10000)
            ||
            (request.resource.data.e2ee == 1
             && request.resource.data.ciphertext is string
             && request.resource.data.ciphertext.size() > 0
             && request.resource.data.ciphertext.size() <= 20000
             && request.resource.data.iv is string
             && request.resource.data.iv.size() > 0
             && request.resource.data.iv.size() <= 128
             && request.resource.data.text == "")
          );

        // Any conversation member may advance receipt state in this transport prototype.
        // Message text, sender and creation fields cannot be changed.
        allow update: if isConversationMember(conversationId)
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state"])
          && request.resource.data.state in ["delivered", "read"];

        allow delete: if false;
      }
    }
  }
}
