rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function userPath(uid){return /databases/$(database)/documents/users/$(uid);}
    function enrolled(){return signedIn() && exists(userPath(request.auth.uid));}
    function profileEnabled(data){
      return (!('active' in data) || data.active == true)
        && (!('status' in data) || data.status == "active")
        && (!('expiresAt' in data) || data.expiresAt == null || request.time < data.expiresAt);
    }
    function registered(){return enrolled() && profileEnabled(get(userPath(request.auth.uid)).data);}
    function myUser(){return get(userPath(request.auth.uid));}
    function isSystemAdmin(){return registered() && myUser().data.systemRole in ["owner", "admin"];}
    function isSystemOwner(){return registered() && myUser().data.systemRole == "owner";}
    function isConversationMember(conversationId){return registered() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;}

    function groupDoc(groupId){return get(/databases/$(database)/documents/groups/$(groupId));}
    function groupDocAfter(groupId){return getAfter(/databases/$(database)/documents/groups/$(groupId));}
    function isGroupMember(groupId){return registered() && exists(/databases/$(database)/documents/groups/$(groupId)) && request.auth.uid in groupDoc(groupId).data.memberUids;}
    function isGroupAdmin(groupId){return isGroupMember(groupId) && request.auth.uid in groupDoc(groupId).data.adminUids;}
    function isGroupAdminAfter(groupId){return registered() && request.auth.uid in groupDocAfter(groupId).data.adminUids;}
    function validGroupLists(data){
      return data.memberUids is list
        && data.adminUids is list
        && data.memberUids.size() > 0
        && data.memberUids.size() <= 64
        && data.adminUids.size() > 0
        && data.adminUids.size() <= 64
        && data.ownerUid in data.memberUids
        && data.ownerUid in data.adminUids
        && data.adminUids.hasOnly(data.memberUids);
    }
    function validGroupShape(data){
      return data.type == "group"
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.ownerUid is string
        && data.createdByUid is string
        && data.ownerUid == data.createdByUid
        && data.historyPolicy == "fromJoin"
        && data.groupVersion == 1
        && data.keyEpoch == 0
        && validGroupLists(data);
    }
    function validInviteRole(role){return role in ["user", "admin"];}
    function inviteAfter(inviteId){return getAfter(/databases/$(database)/documents/invitations/$(inviteId));}
    function validInvitedProfile(uid,data){
      return data.joinedByInviteId is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.email is string
        && data.systemRole in ["user", "admin"]
        && data.active == true
        && inviteAfter(data.joinedByInviteId).data.status == "accepted"
        && inviteAfter(data.joinedByInviteId).data.acceptedUid == uid
        && inviteAfter(data.joinedByInviteId).data.role == data.systemRole;
    }
    function validLifecycle(data){
      return data.status in ["active","suspended","deactivated"]
        && ((data.status == "active" && data.active == true) || (data.status in ["suspended","deactivated"] && data.active == false))
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp);
    }

    // BEGIN E2EE V1 STAGED HELPERS — emulator candidate only
    function validNormalWrapper(w) {
      return w is map
        && w.keys().hasAll(["version","ciphertext","salt","iv","kdf","iterations","wrappingAlgorithm"])
        && w.keys().hasOnly(["version","ciphertext","salt","iv","kdf","iterations","wrappingAlgorithm"])
        && w.version == 1
        && w.ciphertext is string && w.ciphertext.size() > 0 && w.ciphertext.size() <= 4096
        && w.salt is string && w.salt.size() > 0 && w.salt.size() <= 128
        && w.iv is string && w.iv.size() > 0 && w.iv.size() <= 128
        && w.kdf == "PBKDF2-HMAC-SHA256"
        && w.iterations == 600000
        && w.wrappingAlgorithm == "AES-256-GCM";
    }
    function validRecoveryWrapper(w) {
      return w is map
        && w.keys().hasAll(["version","ciphertext","iv","wrappedRecoveryKey","wrappingAlgorithm","recoveryAuthorityVersion","recoveryKeyIv","recoveryKeyWrappingAlgorithm"])
        && w.keys().hasOnly(["version","ciphertext","iv","wrappedRecoveryKey","wrappingAlgorithm","recoveryAuthorityVersion","recoveryKeyIv","recoveryKeyWrappingAlgorithm"])
        && w.version == 1
        && w.ciphertext is string && w.ciphertext.size() > 0 && w.ciphertext.size() <= 4096
        && w.iv is string && w.iv.size() > 0 && w.iv.size() <= 128
        && w.wrappedRecoveryKey is string && w.wrappedRecoveryKey.size() > 0 && w.wrappedRecoveryKey.size() <= 8192
        && w.recoveryKeyIv is string && w.recoveryKeyIv.size() > 0 && w.recoveryKeyIv.size() <= 128
        && w.recoveryKeyWrappingAlgorithm == "HMAC-SHA256+A256GCM"
        && w.wrappingAlgorithm == "AES-256-GCM"
        && w.recoveryAuthorityVersion == 1;
    }
    function validPrivateIdentityCreate(uid, d) {
      return d.keys().hasAll(["schemaVersion","identityVersion","keyId","keyAlgorithm","normalWrapper","recoveryWrapper","state","revision","createdAt","updatedAt"])
        && d.keys().hasOnly(["schemaVersion","identityVersion","keyId","keyAlgorithm","normalWrapper","recoveryWrapper","state","revision","createdAt","updatedAt"])
        && d.schemaVersion == 1 && d.identityVersion == 1
        && d.keyId is string && d.keyId.size() >= 16 && d.keyId.size() <= 128
        && d.keyAlgorithm == "ECDH-P256"
        && validNormalWrapper(d.normalWrapper) && validRecoveryWrapper(d.recoveryWrapper)
        && d.state == "ACTIVE" && d.revision == 1
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function validPrivateIdentityNormalUpdate(d, old) {
      return d.diff(old).affectedKeys().hasOnly(["normalWrapper","revision","updatedAt"])
        && d.schemaVersion == old.schemaVersion && d.identityVersion == old.identityVersion
        && d.keyId == old.keyId && d.keyAlgorithm == old.keyAlgorithm
        && d.recoveryWrapper == old.recoveryWrapper && d.state == old.state
        && validNormalWrapper(d.normalWrapper)
        && d.revision == old.revision + 1 && d.updatedAt == request.time;
    }
    function validPublicIdentity(uid, d) {
      return d.keys().hasAll(["uid","schemaVersion","identityVersion","keyId","keyAlgorithm","publicJwk","state","createdAt","updatedAt"])
        && d.keys().hasOnly(["uid","schemaVersion","identityVersion","keyId","keyAlgorithm","publicJwk","state","createdAt","updatedAt"])
        && d.uid == uid && d.schemaVersion == 1 && d.identityVersion == 1
        && d.keyId is string && d.keyId.size() >= 16 && d.keyId.size() <= 128
        && d.keyAlgorithm == "ECDH-P256"
        && d.publicJwk is map
        && d.publicJwk.keys().hasAll(["kty","crv","x","y"])
        && d.publicJwk.keys().hasOnly(["kty","crv","x","y"])
        && d.publicJwk.kty == "EC" && d.publicJwk.crv == "P-256"
        && d.publicJwk.x is string && d.publicJwk.x.size() > 0 && d.publicJwk.x.size() <= 128
        && d.publicJwk.y is string && d.publicJwk.y.size() > 0 && d.publicJwk.y.size() <= 128
        && !("d" in d.publicJwk) && d.state == "ACTIVE";
    }
    // END E2EE V1 STAGED HELPERS

    // BEGIN ACCOUNT DIRECT-MESSAGE E2EE V3 HELPERS — repository gate only
    function conversationDoc(conversationId){return get(/databases/$(database)/documents/conversations/$(conversationId));}
    function directRecipientUid(conversationId){
      return conversationDoc(conversationId).data.members[0] == request.auth.uid
        ? conversationDoc(conversationId).data.members[1]
        : conversationDoc(conversationId).data.members[0];
    }
    function accountPublicKey(uid){return get(/databases/$(database)/documents/e2eePublicKeys/$(uid));}
    function validAccountDirectMessage(conversationId,d){
      return conversationDoc(conversationId).data.type == "direct"
        && conversationDoc(conversationId).data.members is list
        && conversationDoc(conversationId).data.members.size() == 2
        && request.auth.uid in conversationDoc(conversationId).data.members
        && exists(/databases/$(database)/documents/e2eePublicKeys/$(request.auth.uid))
        && exists(/databases/$(database)/documents/e2eePublicKeys/$(directRecipientUid(conversationId)))
        && d.keys().hasAll(["senderUid","senderName","timeLabel","state","createdAt","text","e2ee","kdfVersion","senderKeyId","recipientKeyId","ciphertext","iv"])
        && d.keys().hasOnly(["senderUid","senderName","timeLabel","state","createdAt","text","e2ee","kdfVersion","senderKeyId","recipientKeyId","ciphertext","iv"])
        && d.senderUid == request.auth.uid
        && d.senderName is string && d.senderName.size() > 0 && d.senderName.size() <= 120
        && d.timeLabel is string && d.timeLabel.size() <= 80
        && d.state == "sent"
        && d.createdAt == request.time
        && d.text == ""
        && d.e2ee == 3
        && d.kdfVersion == 1
        && d.senderKeyId is string && d.senderKeyId.size() >= 16 && d.senderKeyId.size() <= 128
        && d.recipientKeyId is string && d.recipientKeyId.size() >= 16 && d.recipientKeyId.size() <= 128
        && d.senderKeyId == accountPublicKey(request.auth.uid).data.keyId
        && d.recipientKeyId == accountPublicKey(directRecipientUid(conversationId)).data.keyId
        && d.ciphertext is string && d.ciphertext.size() >= 22 && d.ciphertext.size() <= 20000
        && d.ciphertext.matches('^[A-Za-z0-9_-]+$')
        && d.iv is string && d.iv.size() == 16
        && d.iv.matches('^[A-Za-z0-9_-]+$');
    }
    // END ACCOUNT DIRECT-MESSAGE E2EE V3 HELPERS

    match /system/access {
      allow read: if enrolled();
      allow create: if signedIn()
        && exists(userPath(request.auth.uid))
        && !exists(/databases/$(database)/documents/system/access)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /invitations/{inviteId} {
      allow get: if true;
      allow list: if isSystemAdmin();
      allow create: if isSystemAdmin()
        && request.resource.data.status == "pending"
        && validInviteRole(request.resource.data.role)
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp;
      allow update: if (
          signedIn()
          && resource.data.status == "pending"
          && request.time < resource.data.expiresAt
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","acceptedUid","acceptedEmail","acceptedAt"])
        ) || (
          isSystemAdmin()
          && resource.data.status == "pending"
          && request.resource.data.status == "revoked"
          && request.resource.data.role == resource.data.role
          && request.resource.data.invitedByUid == resource.data.invitedByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","revokedAt"])
        );
      allow delete: if false;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && validInvitedProfile(uid,request.resource.data);
      allow update: if (
          registered() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName","email","telephone","photoURL","profileUpdatedAt","e2eePublicJwk","e2eeVersion","e2eeUpdatedAt"])
        ) || (
          registered() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/system/access)
          && getAfter(/databases/$(database)/documents/system/access).data.ownerUid == uid
          && request.resource.data.systemRole == "owner"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["systemRole"])
        ) || (
          isSystemAdmin()
          && request.auth.uid != uid
          && resource.data.systemRole != "owner"
          && (resource.data.systemRole != "admin" || isSystemOwner())
          && request.resource.data.systemRole == resource.data.systemRole
          && request.resource.data.adminUpdatedByUid == request.auth.uid
          && validLifecycle(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","active","expiresAt","suspendedAt","suspendedByUid","restoredAt","restoredByUid","deactivatedAt","deactivatedByUid","adminUpdatedAt","adminUpdatedByUid"])
        );
      allow read: if (signedIn() && request.auth.uid == uid) || registered();
      allow delete: if false;

      // BEGIN E2EE V1 STAGED PRIVATE MATCH — emulator candidate only
      match /e2ee/{docId} {
        allow get: if docId == "identity" && registered() && request.auth.uid == uid;
        allow list: if false;
        allow create: if docId == "identity" && registered() && request.auth.uid == uid && validPrivateIdentityCreate(uid, request.resource.data);
        allow update: if docId == "identity" && registered() && request.auth.uid == uid && validPrivateIdentityNormalUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      // END E2EE V1 STAGED PRIVATE MATCH

      match /devices/{deviceId} {
        allow read: if registered();
        allow create, update: if registered() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.deviceId == deviceId && request.resource.data.e2eeVersion == 1 && request.resource.data.publicJwk is map && request.resource.data.fingerprint is string && request.resource.data.fingerprint.size() <= 128;
        allow delete: if false;
      }
    }

    // BEGIN E2EE V1 STAGED PUBLIC MATCH — emulator candidate only
    match /e2eePublicKeys/{uid} {
      allow get, list: if registered();
      allow create: if registered() && request.auth.uid == uid && validPublicIdentity(uid, request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    // END E2EE V1 STAGED PUBLIC MATCH

    match /conversations/{conversationId} {
      allow read: if registered() && request.auth.uid in resource.data.members;
      allow create: if registered() && request.resource.data.type == "direct" && request.resource.data.members is list && request.resource.data.members.size() == 2 && request.auth.uid in request.resource.data.members;
      allow update: if registered() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members && request.resource.data.type == resource.data.type;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.state == "sent"
          && (
            (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 10000 && !("e2ee" in request.resource.data))
            ||
            (request.resource.data.e2ee == 1 && request.resource.data.ciphertext is string && request.resource.data.ciphertext.size() > 0 && request.resource.data.ciphertext.size() <= 20000 && request.resource.data.iv is string && request.resource.data.iv.size() > 0 && request.resource.data.iv.size() <= 128 && request.resource.data.text == "")
            ||
            (request.resource.data.e2ee == 2 && request.resource.data.ciphertext == "" && request.resource.data.iv == "" && request.resource.data.text == "" && request.resource.data.envelopes is map && request.resource.data.envelopes.size() > 0 && request.resource.data.envelopes.size() <= 32 && request.resource.data.recipientDeviceIds is list && request.resource.data.recipientDeviceIds.size() > 0 && request.resource.data.recipientDeviceIds.size() <= 32)
            ||
            validAccountDirectMessage(conversationId,request.resource.data)
          );
        allow update: if isConversationMember(conversationId) && request.resource.data.senderUid == resource.data.senderUid && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state"]) && request.resource.data.state in ["delivered","read"];
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if registered() && request.auth.uid in resource.data.memberUids;
      allow create: if registered() && request.resource.data.ownerUid == request.auth.uid && validGroupShape(request.resource.data);
      allow update: if isGroupAdmin(groupId)
        && request.resource.data.type == resource.data.type
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.historyPolicy == resource.data.historyPolicy
        && request.resource.data.groupVersion == resource.data.groupVersion
        && request.resource.data.keyEpoch == resource.data.keyEpoch
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && validGroupLists(request.resource.data);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isGroupMember(groupId) || isGroupAdminAfter(groupId);
        allow create: if isGroupAdminAfter(groupId)
          && request.resource.data.uid == uid
          && uid in groupDocAfter(groupId).data.memberUids
          && request.resource.data.role in ["owner", "admin", "member"]
          && request.resource.data.active == true;
        allow update: if isGroupAdmin(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.uid == uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.addedByUid == resource.data.addedByUid
          && uid in groupDocAfter(groupId).data.memberUids
          && request.resource.data.role in ["owner", "admin", "member"]
          && request.resource.data.active == true;
        allow delete: if isGroupAdmin(groupId)
          && uid != groupDoc(groupId).data.ownerUid
          && !(uid in groupDocAfter(groupId).data.memberUids);
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if false;
      }
    }
  }
}